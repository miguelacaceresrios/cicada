# Estructura completa: intro, build, drop, break y drop final.
# Las secciones y su energía viajan en la IR: las visuales las usan para
# cambiar de escena.
bpm 200
seed 2026

# Los efectos (lpf, hpf, delay, reverb) se declaran con el sonido: actúan
# sobre toda la pista, no sobre un golpe suelto.
bass = synth saw gain 0.5 lpf 900
lead = synth square gain 0.3 hpf 400 delay 0.3 reverb 0.2
stab = synth saw gain 0.28 lpf 2500 reverb 0.45

hat  x?x?x?x?x?x?x?x? gain 0.6 pan 0.35

intro 8:
  energy 0.3
  kick x...x...x...x... dist 0.4
  stab ~ ~ C5 ~

build 8:
  energy 0.6
  kick  x...x...x...x... dist 0.6
  snare ....x.......[xx]x gain 0.8 pan -0.25
  bass  C1 ~ C1 ~

drop 16:
  energy 1
  kick  X...x...X...x... dist 0.9
  snare ....x.......x... gain 0.8 pan -0.25
  bass  C1 C1 G0 C1 dist 0.3
  lead  C4 [D#4 D4] G4 [C5 G4] pan 0.4

break 4:
  energy 0.2
  lead C4 ~ G3 ~
  stab ~ G4 ~ [C5 D#5]

drop2 16:
  energy 1
  kick  X.x.X.x.X.x.X.[xx] dist 1
  snare ....x.......x... gain 0.8 pan -0.25
  bass  C1 C1 G0 [C1 C2] dist 0.4
  lead  C5 [D#5 D5] G4 [C5 G5] pan 0.4
  stab  ~ ~ ~ [G5 C6] pan -0.45
